{
  "expo": {
    "name": "考研英语生词本AI版",
    "slug": "kaoyan-english-vocabulary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/MemoGrad.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kaoyan.vocabulary",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "需要访问本地网络以连接生词本同步服务（192.168.1.8）。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/MemoGrad.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.kaoyan.vocabulary"
    },
    "web": {
      "favicon": "./assets/MemoGrad.png"
    },
    "extra": {
      "eas": {
        "projectId": "01a57ae1-7709-4d7d-becf-1cda41278614"
      }
    },
    "owner": "hewengong"
  }
}
