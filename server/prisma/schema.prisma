// MemoGrad 网络版数据模型。
//
// 命名沿用前端 AsyncStorage 里的 snake_case 字段名（word_id、created_at 等），
// 让同步层可以近乎直传，不必维护一层字段名映射表。
//
// 每张用户数据表都带 updated_at / deleted_at，与前端 SyncMeta 一一对应：
// 同步走 last-write-wins，靠 updated_at 比较；删除是软删除，否则删除动作
// 无法传播到其他设备（本地物理删除后无痕迹，拉取时会被当成新数据复活）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 账号与订阅 ====================

model User {
  id        String   @id @default(uuid())
  /// 手机号是主登录标识。国内场景用短信验证码登录，规避密码找回流程。
  phone     String?  @unique
  /// 邮箱作为备选登录方式（海外用户/桌面端），与 phone 至少有一个非空。
  email     String?  @unique
  nickname  String?
  /// 仅邮箱注册时使用（argon2/bcrypt 哈希）。短信登录用户此字段为 null。
  passwordHash String? @map("password_hash")
  role      String   @default("user") @map("role") // user | admin
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  /// 封禁标记，风控用
  disabled  Boolean  @default(false)
  /// 封禁时间。null 表示未被封禁。
  disabledAt DateTime? @map("disabled_at")
  /// 封禁原因（管理员填的备注），仅供审计与运营参考。
  disabledReason String? @map("disabled_reason")
  /// 封禁操作者 userId。null 表示系统封禁（目前没有该路径，保留字段以便未来扩展）。
  disabledById String? @map("disabled_by_id")
  /// 封禁操作者（关联回 User 自己）。不建数据库外键约束，只保留 Prisma 关联便于 JOIN。
  bannedBy     User?   @relation("UserBans", fields: [disabledById], references: [id], onDelete: SetNull)

  devices                 Device[]
  refreshTokens           RefreshToken[]
  subscriptions           Subscription[]
  orders                  Order[]
  aiUsages                AiUsage[]
  words                   Word[]
  studyRecords            StudyRecord[]
  studyPlans              StudyPlan[]
  articles                Article[]
  examSessions            ExamSession[]
  wrongQuestions          WrongQuestion[]
  realExamSessions        RealExamSession[]
  realExamWrongQuestions  RealExamWrongQuestion[]
  /// 该用户作为封禁操作者产生的封禁记录
  bannedUsers             User[]            @relation("UserBans")
  /// 该用户作为管理员产生的审计日志
  adminActionLogs         AdminActionLog[]  @relation("AdminActionLogActor")
  /// 该用户发布的公告
  announcementsCreated    Announcement[]    @relation("AnnouncementCreator")
  /// 该用户作为被操作对象在审计日志里的记录（targetType='user' 时填写）
  auditedAsTarget         AdminActionLog[]  @relation("AdminActionLogTargetUser")

  @@map("users")
}

/// 登录设备。用于"最近登录设备"展示与异地登录风控，也是同步的 lastSyncAt 载体。
model Device {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  /// 客户端生成并持久化的设备标识
  deviceId   String   @map("device_id")
  platform   String   // ios | android | web | desktop
  appVersion String?  @map("app_version")
  /// 该设备最后一次成功同步的服务端时间，增量同步的游标
  lastSyncAt DateTime? @map("last_sync_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("devices")
}

/// 短信/邮箱验证码。存哈希而非明文，防止库被读走后可直接登录任意账号。
model VerificationCode {
  id        String   @id @default(uuid())
  /// 手机号或邮箱
  target    String
  codeHash  String   @map("code_hash")
  purpose   String   // login | bind | reset
  expiresAt DateTime @map("expires_at")
  /// 已使用标记，保证验证码一次性
  consumedAt DateTime? @map("consumed_at")
  /// 尝试次数，超过阈值直接作废，防爆破
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([target, purpose])
  @@index([expiresAt])
  @@map("verification_codes")
}

/// Refresh token 白名单。存哈希；登出/轮换时删除，实现服务端可撤销。
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  deviceId  String?  @map("device_id")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// 订阅。月费为"买断一个月"而非自动续费——微信 Native 支付不支持免密续费，
/// 主动续费模型省掉了代扣签约、续费失败重试、扣款前通知等一整套复杂度。
model Subscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  plan      String   // monthly | quarterly | yearly
  status    String   // active | expired | refunded
  startsAt  DateTime @map("starts_at")
  expiresAt DateTime @map("expires_at")
  /// 来源渠道，用于对账与退款归因
  source    String   // wechat | alipay | manual | gift
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("subscriptions")
}

/// 支付订单。out_trade_no 唯一，是 webhook 幂等的依据——
/// 微信/支付宝都会重复投递回调，没有唯一约束会导致订阅被重复延期。
model Order {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  outTradeNo  String   @unique @map("out_trade_no")
  /// 渠道方返回的交易号，退款时需要
  transactionId String? @map("transaction_id")
  channel     String   // wechat | alipay
  plan        String
  /// 金额以「分」为单位存整数，绝不用浮点表示钱
  amountFen   Int      @map("amount_fen")
  status      String   // pending | paid | closed | refunded
  paidAt      DateTime? @map("paid_at")
  /// 原始回调报文，留档便于对账和纠纷排查
  rawCallback Json?    @map("raw_callback")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("orders")
}

/// AI 调用明细。阶段 3 就要就位，否则定价只能拍脑袋——
/// 需要真实的 token 分布才能定月配额，以及发现异常刷量账号。
model AiUsage {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  action       String   // analyzeWord | generateFunArticle | ...
  model        String
  promptTokens Int      @default(0) @map("prompt_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  /// 上游耗时（毫秒），用于监控 DeepSeek 侧的劣化
  latencyMs    Int      @default(0) @map("latency_ms")
  success      Boolean  @default(true)
  errorCode    String?  @map("error_code")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 按用户+时间查询是配额统计的主路径
  @@index([userId, createdAt])
  @@map("ai_usage")
}

// ==================== 用户学习数据（云同步）====================
// id 由客户端生成（UUID），服务端不再自增——这是多设备离线写入的前提。
// 所有表的 @@index([userId, updatedAt]) 服务于增量拉取：
// "给我这个用户 updatedAt > lastSyncAt 的所有变更"。

model Word {
  id             String   @id
  userId         String   @map("user_id")
  word           String
  pronunciationUk String? @map("pronunciation_uk")
  pronunciationUs String? @map("pronunciation_us")
  /// 释义等结构化内容整块存 JSON：形状由前端定义且会演进，
  /// 拆表会让每次前端加字段都变成一次数据库迁移。
  definitions    Json
  etymology      String?
  similarWords   Json?    @map("similar_words")
  memoryTip      String?  @map("memory_tip")
  difficulty     Int      @default(3)
  frequency      Int      @default(3)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("words")
}

model StudyRecord {
  id        String   @id
  userId    String   @map("user_id")
  /// 关联 Word.id。不建外键约束：同步时记录可能先于单词到达，
  /// 外键会让整批写入失败。改由同步层按 userId 校验归属。
  wordId    String   @map("word_id")
  studyDate String   @map("study_date")
  result    Int
  studyMode String   @map("study_mode")
  updatedAt DateTime @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, studyDate])
  @@map("study_records")
}

model StudyPlan {
  id        String   @id
  userId    String   @map("user_id")
  /// 空串表示"新词占位，具体学哪个词待定"（前端的历史哨兵，原为 0）
  wordId    String   @map("word_id")
  planDate  String   @map("plan_date")
  planType  String   @map("plan_type")
  completed Boolean  @default(false)
  updatedAt DateTime @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, planDate])
  @@map("study_plans")
}

model Article {
  id          String   @id
  userId      String   @map("user_id")
  title       String
  content     String
  translation String
  words       Json
  wordIds     Json     @map("word_ids")
  theme       String
  readCount   Int      @default(0) @map("read_count")
  lastReadAt  DateTime? @map("last_read_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("articles")
}

model ExamSession {
  id           String   @id
  userId       String   @map("user_id")
  questions    Json
  answers      Json
  questionType String   @map("question_type")
  accuracy     Float
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("exam_sessions")
}

model WrongQuestion {
  id            String   @id
  userId        String   @map("user_id")
  question      Json
  wrongAnswer   String   @map("wrong_answer")
  correctCount  Int      @default(0) @map("correct_count")
  wrongCount    Int      @default(0) @map("wrong_count")
  lastAttemptAt DateTime @map("last_attempt_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("wrong_questions")
}

model RealExamSession {
  id        String   @id
  userId    String   @map("user_id")
  year      Int
  mode      String
  paperId   String   @map("paper_id")
  answers   Json
  score     Int
  total     Int
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("real_exam_sessions")
}

/// 真题错题以 questionId 为业务主键（真题内容 ID，非用户实体 ID）。
/// 主键用 (userId, questionId) 复合：同一道真题在不同用户下各有一条。
model RealExamWrongQuestion {
  userId        String   @map("user_id")
  questionId    String   @map("question_id")
  year          Int
  setId         String   @map("set_id")
  mode          String
  paperId       String   @map("paper_id")
  paperTitle    String?  @map("paper_title")
  blankIndex    Int?     @map("blank_index")
  stem          String?
  options       Json
  correctAnswer String   @map("correct_answer")
  userAnswer    String?  @map("user_answer")
  explanation   String?
  wrongCount    Int      @default(0) @map("wrong_count")
  correctCount  Int      @default(0) @map("correct_count")
  lastAttemptAt DateTime @map("last_attempt_at")
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([userId, updatedAt])
  @@map("real_exam_wrong_questions")
}

// ==================== 后台管理 ====================

/// 管理员操作审计日志。每一笔 admin 写操作（封禁、改密、授权、退款等）必写一条。
///
/// 设计要点：
/// - adminUserId 是操作者；targetType/targetId 指向被操作对象（user / order / subscription / announcement）。
/// - before/after 用 Json 存变更前后快照，便于事后复盘"为什么这个用户突然没订阅了"。
/// - ipAddress / userAgent 用于异常操作定位（如果某天突然出现海外 IP 大量封禁，要能查得到）。
/// - 审计写入失败不影响业务事务（best-effort），由 auditLog.writeAuditLog 内部捕获。
model AdminActionLog {
  id           String   @id @default(uuid())
  /// 操作者 userId。User 表删除时该字段置空（审计日志不可被级联删）。
  adminUserId  String?  @map("admin_user_id")
  /// 业务动作标识，如 user.ban / user.reset_password / order.refund / sub.grant。
  /// 客户端按 action 做筛选，因此必须稳定、命名规范统一。
  action       String
  /// 被操作对象类型：user | order | subscription | announcement。
  targetType   String   @map("target_type")
  /// 被操作对象 ID（与 targetType 联合定位）。
  targetId     String   @map("target_id")
  /// 操作前的快照（仅记录发生变更的字段）
  before       Json?
  /// 操作后的快照
  after        Json?
  /// 操作者 IP（Fastify request.ip）
  ipAddress    String?  @map("ip_address")
  /// 操作者 UA，便于排查"是不是被 token 偷了"
  userAgent    String?  @map("user_agent")
  /// 备注：管理员在 confirm 弹窗里输入的原因（封禁/退款/撤销订阅时必填）
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  admin        User?    @relation("AdminActionLogActor", fields: [adminUserId], references: [id], onDelete: SetNull)
  /// targetType='user' 时的反向关联：targetType 字段只用于类型分发，不参与 FK 匹配，
  /// 真实关联按 targetId 单独查询。
  targetUserId String?  @map("target_user_id")
  targetUser   User?    @relation("AdminActionLogTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@map("admin_action_logs")
}

/// 全站公告。客户端按 audience 过滤 + 时间窗过滤后展示。
///
/// 不做多语言、不做富文本——是 Phase F 的 MVP，能用就够。
model Announcement {
  id          String   @id @default(uuid())
  title       String
  body        String
  /// 受众：all=全员，pro=Pro 订阅用户。
  audience    String   @default("all") // all | pro
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  /// 创建者 userId。User 删除时置空，公告保留。
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy   User?    @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([startsAt, endsAt])
  @@index([audience, startsAt])
  @@map("announcements")
}

// ==================== 公共静态内容（词库/真题/故事）====================
//
// 命名约定：
// - 与用户数据表（snake_case + soft delete）不同，这类表字段名沿用前端类型定义
//   （camelCase，如 suggestedDifficulty / examFrequency / memoryTip），避免在 service
//   层做一遍字段转换。
// - 不进 SyncService 同步实体白名单——全站共享、不带 userId 维度。
// - 旧 JSON 文件（src/data/worddict.json 等）作为降级 fallback 保留 1 个 minor。

/// 词库版本号表。一行 = 一个发布版本。
/// 客户端 ETag 协商走 `etag` 字段，零运行时开销。
model WordDictVersion {
  id          String   @id @default(uuid())
  /// 语义化版本号字符串，如 "2026.08.14"
  version     String   @unique
  /// 词条总数（冗余存储以便快速返回元数据）
  wordCount   Int      @map("word_count")
  /// 用于客户端 ETag 协商的版本指纹
  etag        String
  /// 出版时间
  publishedAt DateTime @map("published_at")
  /// 是否为当前生效版本（一个时间点只能有一个 true）
  isCurrent   Boolean  @default(false) @map("is_current")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  /// 与项目 soft-delete 约定保持一致（虽然词库内容通常不删）
  deletedAt   DateTime? @map("deleted_at")

  entries     WordDictEntry[]

  @@map("word_dict_versions")
}

/// 单个词条。word（小写）作为业务主键，不带 UUID。
/// definitions / similar_words 数组存 Json 字段——4801 词条 × 每条数个对象，拆表过度工程。
model WordDictEntry {
  /// 小写英文单词作为主键
  word                String   @id
  versionId           String   @map("version_id")
  /// definitions 数组：[{ part_of_speech, meaning, example?, is_core?, is_rare_sense? }]
  definitions         Json
  /// 词根词缀
  etymology           String?  @db.Text
  /// similar_words 数组：[{ word, relation, description }]
  similarWords        Json     @map("similar_words")
  /// 建议难度 1-5
  suggestedDifficulty Int?     @map("suggested_difficulty")
  /// 考试频次 1-5
  examFrequency       Int?     @map("exam_frequency")
  /// 记忆口诀
  memoryTip           String?  @db.Text @map("memory_tip")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  version     WordDictVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("word_dict_entries")
}

// ==================== 真题内容（全局共享，题面/答案/解析） ====================
//
// 与词库同属公共静态内容：不带 userId、不进同步实体白名单。
// 字段命名沿用前端类型（RealExamReadingPassage / RealExamClozePaper 等）
// 直接镜像 JSON 形态——题面/选项/解析都以 Json 或 Text 存。
//
// 关键约束：paperId / questionId 是 RealExamWrongQuestion 的业务主键
// （2023-e1-text1-q21 这种），迁移前后必须字节级一致，绝不重排。

/// 套卷元信息。一行 = (year, setId) 一套卷。
/// 派生信息：2023 + english1 → paperId 前缀 "2023-e1-"
model RealExamPaper {
  id          String   @id @default(uuid())
  year        Int
  setId       String   @map("set_id")  // english1 | english2
  /// 该套卷的 paperId 列表：["2023-e1-text1", ..., "2023-e1-cloze", ...]
  /// 存 Json 数组，方便一次拉全元信息。
  paperIds    Json     @map("paper_ids")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  passages         RealExamPassage[]
  clozePaper       RealExamCloze?
  newTypePaper     RealExamNewType?
  translationPaper RealExamTranslation?
  writingPaper     RealExamWriting?

  @@unique([year, setId])
  @@index([year, setId])
  @@map("real_exam_papers")
}

/// 阅读题文章。一篇一行。paperId 是业务主键（如 "2023-e1-text1"）。
model RealExamPassage {
  id          String   @id @default(uuid())
  paperId     String   @unique @map("paper_id")  // 业务主键
  paperRefId  String   @map("paper_ref_id")  // FK → RealExamPaper.id
  /// text1 / text2 / text3 / text4
  passageKey  String   @map("passage_key")
  title       String
  /// 英文正文（可能数 KB，Text 而非 VarChar）
  passage     String   @db.Text
  /// 段落级中英对照：[ { en, zh } ]，存 Json
  paragraphs  Json
  /// questions 数组：[ { id, stem, options[], answer, explanation? } ]
  /// 存 Json 数组
  questions   Json

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  paper       RealExamPaper @relation(fields: [paperRefId], references: [id], onDelete: Cascade)

  @@index([paperRefId])
  @@map("real_exam_passages")
}

/// 完形。一套卷只有一篇。
model RealExamCloze {
  id          String   @id @default(uuid())
  paperId     String   @unique @map("paper_id")  // "2023-e1-cloze"
  paperRefId  String   @unique @map("paper_ref_id")
  /// 含 [1]..[20] 占位的 passage
  passage     String   @db.Text
  /// 段落级中英对照
  paragraphs  Json
  /// blanks 数组：[{ index, options[], answer, explanation? }]
  blanks      Json

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  paper       RealExamPaper @relation(fields: [paperRefId], references: [id], onDelete: Cascade)

  @@map("real_exam_clozes")
}

/// 新题型（如七选五/排序）。
/// 结构直接镜像 JSON：无 passage 字段，题干是 direction + options + questions。
model RealExamNewType {
  id          String   @id @default(uuid())
  paperId     String   @unique @map("paper_id")
  paperRefId  String   @unique @map("paper_ref_id")
  /// subtype: ordering | matching 等
  subtype     String
  /// 大题方向/说明
  direction   String   @db.Text
  /// options 数组：[{ letter, text }]
  options     Json
  /// questions 数组：[{ index, answer, explanation? }]
  questions   Json

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  paper       RealExamPaper @relation(fields: [paperRefId], references: [id], onDelete: Cascade)

  @@map("real_exam_newtypes")
}

/// 翻译题。结构镜像 JSON。
model RealExamTranslation {
  id          String   @id @default(uuid())
  paperId     String   @unique @map("paper_id")
  paperRefId  String   @unique @map("paper_ref_id")
  /// subtype: sentence 等
  subtype     String
  direction   String   @db.Text
  passage     String   @db.Text
  /// items 数组：[{ index, en, zh }]
  items       Json

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  paper       RealExamPaper @relation(fields: [paperRefId], references: [id], onDelete: Cascade)

  @@map("real_exam_translations")
}

/// 写作题。结构镜像 JSON：parts 数组（Part A 小作文 + Part B 大作文）。
model RealExamWriting {
  id          String   @id @default(uuid())
  paperId     String   @unique @map("paper_id")
  paperRefId  String   @unique @map("paper_ref_id")
  /// parts 数组：[{ label, direction, ... }]
  parts       Json

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  paper       RealExamPaper @relation(fields: [paperRefId], references: [id], onDelete: Cascade)

  @@map("real_exam_writings")
}

// ==================== 系列故事（全局共享） ====================

/// 系列故事元信息。20 章为一组，1:1 拆分成 StoryChapter。
/// 字段命名跟前端 StorySeries 接口保持一致。
model Story {
  id            String   @id @default(uuid())
  /// 系列标题，如「星际漫游者：4801词奇幻之旅」
  seriesTitle   String   @unique @map("series_title")
  /// 词表词数（生成设计如此：4801 词覆盖 worddict 全集）
  totalWords    Int      @map("total_words")
  /// 章节总数。当前固定 20，未来加新系列时此字段决定是建新 Story 还是扩展现有
  totalChapters Int      @map("total_chapters")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  /// 软删除位（与项目 SyncMeta 风格统一）
  deletedAt     DateTime? @map("deleted_at")

  chapters      StoryChapter[]

  @@map("stories")
}

/// 单个章节。chapterId 是数字（1..20）——是内容索引而非用户实体 ID，
/// 与路由参数 navigation/types.ts 的 chapterId 保持一致，勿改 UUID。
model StoryChapter {
  id          String   @id @default(uuid())
  storyId     String   @map("story_id")
  /// 章节号 1..20，全剧内唯一
  chapterId   Int      @map("chapter_id")
  title       String
  /// 英文正文（可能数 KB，Text 而非 VarChar）
  content     String   @db.Text
  /// 中文译文，与 content 段数锁步
  translation String   @db.Text
  /// 目标词词形数组（暂存 Json；未来 worddict 后端化后改为 UUID 数组）
  words       Json
  /// 真实正文字数（不含 title）
  wordCount   Int      @map("word_count")
  /// 主题枚举字符串：adventure / sciFi / mystery / ...
  theme       String

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, chapterId])
  @@index([storyId, chapterId])
  @@map("story_chapters")
}
