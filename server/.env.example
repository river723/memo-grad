# 本地开发环境变量示例。复制为 .env 后按需修改。
# .env 已被 .gitignore 忽略，切勿提交真实密钥。

# ---- 数据库 ----
# 端口 55432 对应 docker-compose.yml 的映射（避开本机可能已有的 5432）
# 用 127.0.0.1 而非 localhost：Windows 上 localhost 可能解析到 IPv6 ::1，
# 而 Docker 的端口映射只监听 IPv4，Prisma 会报 P1001 连不上（Node 的 net 却能连）。
DATABASE_URL="postgresql://memograd:memograd_dev_pw@127.0.0.1:55432/memograd?schema=public"
REDIS_URL="redis://127.0.0.1:56379"

# ---- 服务 ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# 允许的前端来源，逗号分隔。生产必须收紧为真实域名。
CORS_ORIGINS="http://localhost:19006,http://localhost:8081,http://localhost:3000"

# ---- JWT ----
# 生产环境务必换成随机长字符串：openssl rand -base64 48
JWT_SECRET="dev-only-secret-change-me-in-production-please"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# ---- 短信验证码 ----
# 开发模式下不真正发短信，验证码直接写进日志与接口响应（见 SMS_DEV_ECHO）
SMS_PROVIDER=console
SMS_DEV_ECHO=true
VERIFICATION_CODE_TTL_SECONDS=300
# 同一手机号发送间隔与单日上限，防刷
SMS_RESEND_COOLDOWN_SECONDS=60
SMS_DAILY_LIMIT_PER_TARGET=10

# ---- AI 上游（阶段 3 使用）----
# 服务端代理后这是唯一的成本出口，务必用一个专用于生产的 key。
# 这里配置的是 OpenAI 兼容协议，所以可以指向任何兼容服务，下面是常见模板：
#   DeepSeek (默认):   https://api.deepseek.com/v1       模型示例 deepseek-v4-flash / deepseek-chat
#   智谱 GLM-4:        https://open.bigmodel.cn/api/paas/v4  模型示例 glm-4-flash / glm-4-plus
#   月之暗面 Kimi:     https://api.moonshot.cn/v1         模型示例 moonshot-v1-8k / moonshot-v1-32k
#   通义千问 Qwen:     https://dashscope.aliyuncs.com/compatible-mode/v1  模型示例 qwen-plus / qwen-turbo
#   OpenAI:            https://api.openai.com/v1          模型示例 gpt-4o-mini / gpt-4o
#   Ollama 本地:       http://localhost:11434/v1          模型示例 qwen2.5:7b / llama3.1:8b（key 随便填）
AI_API_KEY=""
AI_BASE_URL="https://api.deepseek.com/v1"
AI_MODEL="deepseek-v4-flash"

# ---- 兼容旧环境变量名（已弃用，下一版本会移除）----
# 若 AI_* 三个变量都未设置，代码会回退读这里。给老部署一个过渡期，新部署直接配上面就行。
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-v4-flash"

改 server/.env（或部署平台的环境变量）三行就行：
Copy code to clipboard
# 智谱 GLM
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-4-flash
AI_API_KEY=你的key

# 月之暗面 Kimi
AI_BASE_URL=https://api.moonshot.cn/v1
AI_MODEL=moonshot-v1-8k
AI_API_KEY=你的key

# 通义千问 Qwen
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
AI_API_KEY=你的key

# Ollama 本地
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5:7b
AI_API_KEY=ollama   # Ollama 不验 key
无需重启 —— 等等，其实需要重启服务进程，Node 启动时读一次 config。改完 .env 重启 server 即可。

# ---- 订阅配额（阶段 3 使用）----
# 免费用户每月赠送的 AI 次数（0 = 完全不开放）
FREE_MONTHLY_AI_QUOTA=0
# 付费用户每月 AI 调用上限。初期设保守值，观察 ai_usage 真实分布后再放宽。
PRO_MONTHLY_AI_QUOTA=300
