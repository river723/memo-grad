# 飞牛 NAS 生产部署环境变量模板。
# 复制为 .env.production 并填写真实值:.env.production 已被 .gitignore 忽略,不会提交。
# 命令: cp .env.production.example .env.production

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ---- 数据库 ----
# 改成 NAS 上已有 Postgres 的真实连接串。
# 若 PG 跑在宿主机并映射了端口,用 192.168.1.8:<端口>;若为同网络的独立容器,可用容器名。
DATABASE_URL=postgresql://<USER>:<PASSWORD>@192.168.1.8:5432/memograd?schema=public
# 后端代码不使用 Redis,留空即可
REDIS_URL=

# ---- JWT ----
# 用 node -e "console.log(require('crypto').randomBytes(48).toString('base64'))" 生成
JWT_SECRET=<随机长字符串>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- CORS ----
# 必须包含 Tauri 桌面源 http://tauri.localhost;web 域名/局域网开发源按需追加
CORS_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost,http://192.168.1.8:5666,http://localhost:19006

# ---- 短信验证码(自托管)----
# 无真实短信网关时走 console,从 `docker logs memograd-api` 取验证码
SMS_PROVIDER=console
SMS_ALLOW_CONSOLE_IN_PRODUCTION=true
SMS_DEV_ECHO=false
VERIFICATION_CODE_TTL_SECONDS=300
SMS_RESEND_COOLDOWN_SECONDS=60
SMS_DAILY_LIMIT_PER_TARGET=10

# ---- AI 上游 ----
AI_API_KEY=<沿用现有生产值>
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-flash

# ---- 订阅配额 ----
FREE_MONTHLY_AI_QUOTA=0
PRO_MONTHLY_AI_QUOTA=300
