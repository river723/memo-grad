{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "考研单词·在线版",
  "version": "1.0.0",
  "identifier": "com.kaoyan.vocabulary",
  "build": {
    "frontendDist": "../web-build",
    "devUrl": "http://localhost:19006",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "考研单词·在线版",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "target/release/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "wix": {
        "language": ["zh-CN"]
      }
    }
  }
}
